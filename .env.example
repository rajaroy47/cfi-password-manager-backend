# Copy this file to server/.env and fill in real values.
# The server refuses to start if any of these are missing or too weak
# (see server/src/config/env.js).

# --- Server ---
PORT=4000
NODE_ENV=production

# --- Database ---
# Local MongoDB example:
#   MONGODB_URI=mongodb://localhost:27017/company_password_manager
# MongoDB Atlas example:
#   MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/company_password_manager
MONGODB_URI=mongodb://localhost:27017/company_password_manager

# --- Auth secrets ---
# Generate strong random values, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Encryption ---
# Must be a 64-character hex string (32 bytes) for AES-256-GCM. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER commit this value. Losing it means all stored passwords become
# unrecoverable — see SECURITY.md for backup guidance.
ENCRYPTION_KEY=

# --- CORS ---
# Comma-separated list of origins allowed to call the API (admin dashboard URL(s)).
CORS_ORIGIN=http://localhost:5173,http://192.168.1.100:5173

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# --- Clipboard ---
CLIPBOARD_TIMEOUT_SECONDS=30
